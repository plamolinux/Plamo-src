#!/bin/sh
##############################################################
pkgbase="qtwebengine6"
vers="6.8.4"
url="https://download.qt.io/archive/qt/${vers%.*}/${vers}/single/qt-everywhere-opensource-src-${vers}.tar.xz"
verify=""
digest=""
arch=`uname -m`
build=B1
src="qt-everywhere-src-${vers}"
# パッチの当たっていないffmpegには対応していないので
# -DQT_FEATURE_webengine_system_ffmpeg=OFF にした
OPT_CONFIG="
-DCMAKE_MESSAGE_LOG_LEVEL=STATUS
-DQT_GENERATE_SBOM=OFF
-DQT_FEATURE_webengine_system_ffmpeg=OFF
-DQT_FEATURE_webengine_system_icu=ON
-DQT_FEATURE_webengine_system_libevent=ON
-DQT_BUILD_EXAMPLES_BY_DEFAULT=OFF
-DFEATURE_webengine_proprietary_codecs=ON
-DFEATURE_webengine_webrtc_pipewire=ON
-DINSTALL_INCLUDEDIR=include/qt6
-DINSTALL_BINDIR=/usr/lib/qt6/bin
-DINSTALL_DOCDIR=/usr/share/doc/qtwebengine6-${vers}
-DINSTALL_ARCHDATADIR=/usr/lib/qt6
-DINSTALL_DATADIR=/usr/share/qt6
-DINSTALL_MKSPECSDIR=/usr/lib/qt6/mkspecs
-DINSTALL_EXAMPLESDIR=/usr/share/doc/qtwebengine6-${vers}/examples
-G Ninja 
"
DOCS="README.md README.md.template qtdoc"
patchfiles=""
# specifies files that are not in source archive and patchfiles
addfiles=""
compress=tzst
##############################################################

source /usr/share/plamobuild_functions.sh
B=$W/build_qtwebengine

# このスクリプトで使う1文字変数の意味
#
# $W : このスクリプトを動かすカレントディレクトリ
# $S : ソースコードのあるディレクトリ(デフォルト: $W/${src})
# $B : ビルド用ディレクトリ(デフォルト: /tmp/build)
# $P : ビルドしたファイルをインストールするディレクトリ（デフォルト: $W/work)

if [ $# -eq 0 ] ; then
  opt_download=0 ; opt_config=1 ; opt_build=1 ; opt_package=1
else
  opt_download=0 ; opt_config=0 ; opt_build=0 ; opt_package=0
  for i in $@ ; do
    case $i in
    download) opt_download=1 ;;
    config) opt_config=1 ;;
    build) opt_build=1 ;;
    package) opt_package=1 ;;
    esac
  done
fi
if [ $opt_download -eq 1 ] ; then
    download_sources
fi


if [ $opt_config -eq 1 ] ; then

    for f in $addfiles $patchfiles
    do
        if [ ! -f $f ]; then
            echo "Required file ($f) is missing."
            exit 255
        fi
    done

######################################################################
#  out of tree build. patch apply in src dir
######################################################################
    if [ -d $B ] ; then rm -rf $B ; fi ; mkdir -p $B 
    cd $S
    for patch in $patchfiles ; do
        if [ ! -f .${patch} ]; then
            patch -p1 < $W/$patch
            touch .${patch}
        fi
    done

    find $S/qtwebengine/src/3rdparty/chromium -type f \( -name "*.h" -o -name "*.hpp" -o -name "*.cpp" \) \
       -exec grep -qE '\b(u?int(8|16|32|64)_t|uintptr_t|intptr_t)\b' {} \; \
       ! -exec grep -qE '<(cstdint|stdint\.h)>' {} \; \
       -exec sed -i '0,/#include/s|#include.*|&\n#ifdef __cplusplus\n#include <cstdint>\n#else\n#include <stdint.h>\n#endif|' {} \;

    # 先頭付近で signal.h を読み込ませ、Glibc 側の enum 定義を先に終わらせる
    sed -i '0,/#include/s|#include.*|&\n#include <signal.h>|' \
       $S/qtwebengine/src/3rdparty/chromium/sandbox/linux/system_headers/linux_seccomp.h

    sed -i 's/static_assert(__LINE__ == [0-9]*/static_assert(true/' \
       $S/qtwebengine/src/3rdparty/chromium/third_party/blink/renderer/core/html/fenced_frame/fenced_frame_config.h

    # if [ -f autogen.sh ] ; then
    #   sh ./autogen.sh
    # fi
    cd $B
    export PKG_CONFIG_PATH=/usr/${libdir}/pkgconfig:/usr/share/pkgconfig
    export LDFLAGS='-Wl,--as-needed' 
    cmake -DCMAKE_INSTALL_PREFIX:PATH=/usr ${OPT_CONFIG} $S/qtwebengine 
    if [ $? != 0 ]; then
        echo "configure error. $0 script stop"
        exit 255
    fi
fi

if [ $opt_build -eq 1 ] ; then
    cd $B 
    export LDFLAGS='-Wl,--as-needed'
    ninja -j`nproc`
    if [ $? != 0 ]; then
        echo "build error. $0 script stop"
        exit 255
    fi
fi

if [ $opt_package -eq 1 ] ; then
  check_root
  if [ -d $P ] ; then rm -rf $P ; fi ; mkdir -p $P
  cd $B

  export LDFLAGS='-Wl,--as-needed'
  DESTDIR=$P ninja install 

  src=qtwebengine6-${vers}

################################
#      install tweaks
#  strip binaries, delete locale except ja, compress man,
#  install docs and patches, compress them and  chown root.root
################################
  install_tweak

#############################
#   convert symlink to null file and
#   add "ln -sf" command into install/doinst.sh
################################
  convert_links

  cd $P
  /sbin/makepkg ../$pkg.$compress <<EOF
y
1
EOF

fi
