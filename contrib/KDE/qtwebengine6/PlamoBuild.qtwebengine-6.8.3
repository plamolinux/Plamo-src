rm $P/usr/bin/qt-configure-module6
rm $P/usr/bin/qtdiag6
rm $P/usr/bin/qtpaths6
rm $P/usr/bin/qtplugininfo6
rm $P/usr/bin/shadergen6
rm $P/usr/bin/shapegen6
rm $P/usr/bin/svgtoqml6

find $P -type d -empty -print0 | xargs -0 rmdir

src=qtwebengine6-${vers}

################################
#      install tweaks
#  strip binaries, delete locale except ja, compress man,
#  install docs and patches, compress them and  chown root.root
################################
  install_tweak

#############################
#   convert symlink to null file and
#   add "ln -sf" command into install/doinst.sh
################################
  convert_links

  cd $P
  /sbin/makepkg ../$pkg.$compress <<EOF
y
1
EOF

fi
