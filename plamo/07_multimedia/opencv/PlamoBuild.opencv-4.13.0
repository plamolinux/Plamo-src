#!/bin/sh
##############################################################
pkgbase="opencv"
vers="4.13.0"
url="https://github.com/opencv/opencv/archive/refs/tags/${vers}.tar.gz"
verify=""
digest=""
arch=`uname -m`
build=B2
src="opencv-${vers}"
OPT_CONFIG="-DCMAKE_BUILD_TYPE=Release -DENABLE_CXX11=ON -DBUILD_PERF_TESTS=OFF 
	    -DWITH_FFMPEG=ON -DWITH_OPENGL=ON -DWITH_OPENMP=ON -DWITH_QT=ON 
	    -DBUILD_TESTS=OFF -DENABLE_PRECOMPILED_HEADERS=OFF 
	    -DOPENCV_EXTRA_MODULES_PATH=../${pkgbase}_contrib-${vers}/modules
	    -DCMAKE_SKIP_RPATH=ON -DBUILD_WITH_DEBUG_INFO=OFF -Wno-dev"
#    -DWITH_XINE=ON
DOCS="LICENSE README.md doc"
patchfiles=""
# specifies files that are not in source archive and patchfiles
addfiles=""
# https://github.com/opencv/opencv_contrib/archive/refs/tags/${vers}.tar.gz
extrasrc="${pkgbase}_contrib-${vers}.tar.gz"
compress=tzst
##############################################################

source /usr/share/plamobuild_functions.sh

# このスクリプトで使う1文字変数の意味
#
# $W : このスクリプトを動かすカレントディレクトリ
# $S : ソースコードのあるディレクトリ(デフォルト: $W/${src})
# $B : ビルド用ディレクトリ(デフォルト: /tmp/build)
# $P : ビルドしたファイルをインストールするディレクトリ（デフォルト: $W/work)

if [ $# -eq 0 ] ; then
  opt_download=0 ; opt_config=1 ; opt_build=1 ; opt_package=1
else
  opt_download=0 ; opt_config=0 ; opt_build=0 ; opt_package=0
  for i in $@ ; do
    case $i in
    download) opt_download=1 ;;
    config) opt_config=1 ;;
    build) opt_build=1 ;;
    package) opt_package=1 ;;
    esac
  done
fi
if [ $opt_download -eq 1 ] ; then
    download_sources
    wget -N https://github.com/opencv/opencv_contrib/archive/refs/tags/${vers}.tar.gz -O opencv_contrib.tar.gz
    cd $S
    tar xvf $W/opencv_contrib.tar.gz
fi


if [ $opt_config -eq 1 ] ; then

    for f in $addfiles $patchfiles
    do
        if [ ! -f $f ]; then
            echo "Required file ($f) is missing."
            exit 255
        fi
    done

######################################################################
#  out of tree build. patch apply in src dir
######################################################################
    if [ -d $B ] ; then rm -rf $B ; fi ; mkdir -p $B 
    cd $S
    for patch in $patchfiles ; do
        if [ ! -f .${patch} ]; then
            patch -p1 < $W/$patch
            touch .${patch}
        fi
    done
    # extract contrib src here
#    tar xvf $W/${pkgbase}_contrib-${vers}.tar.gz
    
    # if [ -f autogen.sh ] ; then
    #   sh ./autogen.sh
    # fi
    #cd $B
    mkdir -p $S/cmake_build
    cd $S/cmake_build
    export PKG_CONFIG_PATH=/usr/${libdir}/pkgconfig:/usr/share/pkgconfig
    export LDFLAGS='-Wl,--as-needed' 
    cmake -G Ninja -DCMAKE_INSTALL_PREFIX:PATH=/usr ${OPT_CONFIG} ..  
    if [ $? != 0 ]; then
        echo "configure error. $0 script stop"
        exit 255
    fi
fi

if [ $opt_build -eq 1 ] ; then
    cd $S/cmake_build
    NUMJOBS=${NUMJOBS:-" -j$(expr $(nproc) + 1) "}

    ninja $NUMJOBS
    if [ $? != 0 ]; then
        echo "build error. $0 script stop"
        exit 255
    fi
fi

if [ $opt_package -eq 1 ] ; then
  check_root
  if [ -d $P ] ; then rm -rf $P ; fi ; mkdir -p $P
  cd $S/cmake_build

  DESTDIR=$P ninja install

################################
#      install tweaks
#  strip binaries, delete locale except ja, compress man,
#  install docs and patches, compress them and  chown root.root
################################
  install_tweak

#############################
#   convert symlink to null file and
#   add "ln -sf" command into install/doinst.sh
################################
  convert_links

  cd $P
  /sbin/makepkg ../$pkg.$compress <<EOF
y
1
EOF

fi
