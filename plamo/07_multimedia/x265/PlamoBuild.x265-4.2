#!/bin/sh
##############################################################
pkgbase="x265"
vers="4.2"
url="https://bitbucket.org/multicoreware/x265_git.git"
commitid="${vers}"
verify=""
digest=""
arch=`uname -m`
build=B1
src="x265_git"
OPT_CONFIG=(-S source
	    -G Ninja
	    -D CMAKE_INSTALL_PREFIX=/usr
	    -D ENABLE_HDR10_PLUS=TRUE
)	    
HDR_OPTIONS=(
    "${OPT_CONFIG[@]}"
    -D ENABLE_CLI=FALSE
    -D ENABLE_SHARED=FALSE
    -D EXPORT_C_API=FALSE
    -D HIGH_BIT_DEPTH=TRUE
)
FINAL_OPTIONS=(
    "${OPT_CONFIG[@]}"
    -D ENABLE_SHARED=TRUE
    -D EXTRA_LIB='x265_main10.a;x265_main12.a'
    -D EXTRA_LINK_FLAGS='-L .'
    -D LINKED_10BIT=TRUE
    -D LINKED_12BIT=TRUE
)
DOCS=".readthedocs.yaml COPYING doc readme.rst x265Version.txt"
patchfiles="0001-Fix-build-with-GCC-15.patch"
# specifies files that are not in source archive and patchfiles
addfiles=""
compress=tzst
##############################################################

source /usr/share/plamobuild_functions.sh


# このスクリプトで使う1文字変数の意味
#
# $W : このスクリプトを動かすカレントディレクトリ
# $S : ソースコードのあるディレクトリ(デフォルト: $W/${src})
# $B : ビルド用ディレクトリ(デフォルト: /tmp/build)
# $P : ビルドしたファイルをインストールするディレクトリ（デフォルト: $W/work)

if [ $# -eq 0 ] ; then
  opt_download=0 ; opt_config=1 ; opt_build=1 ; opt_package=1
else
  opt_download=0 ; opt_config=0 ; opt_build=0 ; opt_package=0
  for i in $@ ; do
    case $i in
    download) opt_download=1 ;;
    config) opt_config=1 ;;
    build) opt_build=1 ;;
    package) opt_package=1 ;;
    esac
  done
fi
if [ $opt_download -eq 1 ] ; then
    download_sources
fi

if [ $opt_config -eq 1 ] ; then

    for f in $addfiles $patchfiles
    do
        if [ ! -f $f ]; then
            echo "Required file ($f) is missing."
            exit 255
        fi
    done

######################################################################
#  source copy build. patch apply in build dir
######################################################################
    if [ -d $B ] ; then rm -rf $B ; fi ;  cp -a $S $B  
    cd $B
    for patch in $patchfiles ; do
       patch -p1 < $W/$patch
    done
    # if [ -f autogen.sh ] ; then
    #   sh ./autogen.sh
    # fi
    cmake -B build-10 "${HDR_OPTIONS[@]}"
    cmake -B build-12 "${HDR_OPTIONS[@]}" -D MAIN12=TRUE
fi

if [ $opt_build -eq 1 ] ; then
    cd $B 
    export LDFLAGS='-Wl,--as-needed'
    cmake --build build-10
    cmake --build build-12

    cmake -B build "${FINAL_OPTIONS[@]}"
    ln -sr build-10/libx265.a build/libx265_main10.a
    ln -sr build-12/libx265.a build/libx265_main12.a
    cmake --build build
fi

if [ $opt_package -eq 1 ] ; then
  check_root
  if [ -d $P ] ; then rm -rf $P ; fi ; mkdir -p $P
  cd $B

  src="${pkgbase}-${vers}"
  export LDFLAGS='-Wl,--as-needed'
  DESTDIR=$P cmake --install build

################################
#      install tweaks
#  strip binaries, delete locale except ja, compress man,
#  install docs and patches, compress them and  chown root.root
################################
  install_tweak

#############################
#   convert symlink to null file and
#   add "ln -sf" command into install/doinst.sh
################################
  convert_links

  cd $P
  /sbin/makepkg ../$pkg.$compress <<EOF
y
1
EOF

fi
