#!/bin/sh
##############################################################
pkgbase="ffmpeg"
vers="7.1.4"
url="https://ffmpeg.org/releases/ffmpeg-${vers}.tar.xz"
verify="${url}.asc"
digest=""
arch=`uname -m`
build=B1
# B4: rebuilt because libvpx was updated
# B2: Add "avformat-iamf_parse update" patch_(cherry picked from commit:faa382e)
# B1: Compiled against AMD-headers-1.5.0 and nv-codec-headers-13.0.9.0(B2)
#     and Vulkan-1.4.332 (Kojima-san)
src="ffmpeg-${vers}"
# Arch linux options which didn't apply
#    --enable-avisynth
#    --enable-ladspa
#    --enable-libiec61883 \
#    --enable-libmfx \
#   --enable-libmodplug \
#   --enable-libopencore_amrnb \
#    --enable-libopencore_amrwb \
##    --enable-librav1e \
#  --enable-libssh \
#   --enable-libsrt \
#    --enable-libvidstab \
#   --enable-libvmaf \
#    --enable-nvdec \
#    --enable-nvenc \
#    --enable-amf \

# 高品質のAACコーデックライブラリを使いたい場合は
# --enable-libfdk-aac
# をつけてビルドしてください。バイナリ配布は不可なので含めてません
# ffmpeg 付属の AAC コーデックは含まれているはず
# See. https://trac.ffmpeg.org/wiki/Encode/AAC
OPT_CONFIG="--disable-static
    --disable-debug
    --disable-stripping
    --enable-lto
    --enable-fontconfig
    --enable-gmp
    --enable-gnutls
    --enable-gpl
    --enable-nonfree 
    --enable-encoder=aac
    --enable-libfdk-aac 
    --enable-libaom
    --enable-libass
    --enable-libbluray
    --enable-libdav1d
    --enable-libdrm
    --enable-libfreetype
    --enable-libfribidi
    --enable-libgsm
    --enable-libjack
    --enable-libmp3lame
    --enable-libopenjpeg
    --enable-libopus
    --enable-libplacebo 
    --enable-libpulse
    --enable-libspeex
    --enable-libtheora
    --enable-libv4l2
    --enable-libsoxr
    --enable-libvorbis
    --enable-libvpx
    --enable-libwebp
    --enable-libx264
    --enable-libx265
    --enable-libxcb
    --enable-libxml2
    --enable-libxvid
    --enable-shared
    --enable-libbluray
    --enable-version3 
    --enable-ffnvcodec 
    --enable-cuda 
    --enable-cuvid 
    --enable-nvenc 
    --enable-nvdec 
    --enable-libvpl 
    --enable-libxeve
    --enable-libxevd
    --enable-vulkan 
    --enable-opengl
    --enable-libharfbuzz"

DOCS="COPYING.GPLv2 COPYING.GPLv3 COPYING.LGPLv2.1 COPYING.LGPLv3 Changelog INSTALL.md LICENSE.md MAINTAINERS README.md RELEASE RELEASE_NOTES doc"
patchfiles="add-av_stream_get_first_dts-for-chromium.patch"
# specifies files that are not in source archive and patchfiles
addfiles="FFmpeg-info.sh"
oldlib=''
compress=tzst
##############################################################

source /usr/share/plamobuild_functions.sh

# このスクリプトで使う1文字変数の意味
#
# $W : このスクリプトを動かすカレントディレクトリ
# $S : ソースコードのあるディレクトリ(デフォルト: $W/${src})
# $B : ビルド用ディレクトリ(デフォルト: /tmp/build)
# $P : ビルドしたファイルをインストールするディレクトリ（デフォルト: $W/work)

if [ $# -eq 0 ] ; then
  opt_download=0 ; opt_config=1 ; opt_build=1 ; opt_package=1
else
  opt_download=0 ; opt_config=0 ; opt_build=0 ; opt_package=0
  for i in $@ ; do
    case $i in
    download) opt_download=1 ;;
    config) opt_config=1 ;;
    build) opt_build=1 ;;
    package) opt_package=1 ;;
    esac
  done
fi
if [ $opt_download -eq 1 ] ; then
    download_sources
fi


if [ $opt_config -eq 1 ] ; then

    for f in $addfiles $patchfiles
    do
        if [ ! -f $f ]; then
            echo "Required file ($f) is missing."
            exit 255
        fi
    done

######################################################################
#  copy source build. patch apply in build dir
######################################################################
    if [ -d $B ] ; then rm -rf $B ; fi ; mkdir -p $B 
    cd $S
    for patch in $patchfiles ; do
        if [ ! -f .${patch} ]; then
            patch -p1 < $W/$patch
            touch .${patch}
        fi
    done

    # set RELEASE-version
    #sed -e 's/7.1.git/7.1.git-99e2af4/g' -i RELEASE

    # if [ -f autogen.sh ] ; then
    #   sh ./autogen.sh
    # fi

    cd $B
    export PKG_CONFIG_PATH=/usr/${libdir}/pkgconfig:/usr/share/pkgconfig
    export LDFLAGS='-Wl,--as-needed -Wno-error=int-conversion -Wno-error=incompatible-pointer-types' 
    $S/configure --prefix=/usr --libdir=/usr/${libdir} --mandir=/usr/share/man ${OPT_CONFIG}
    if [ $? != 0 ]; then
        echo "configure error. $0 script stop"
        exit 255
    fi
fi

if [ $opt_build -eq 1 ] ; then
    cd $B
    NUMJOBS=${NUMJOBS:-" -j$(expr $(nproc) + 1) "}
    export LDFLAGS='-Wl,--as-needed'
    make $NUMJOBS
    if [ $? != 0 ]; then
        echo "build error. $0 script stop"
        exit 255
    fi

    make tools/qt-faststart
    make doc/ff{mpeg,play}.1

fi

if [ $opt_package -eq 1 ] ; then
  check_root
  if [ -d $P ] ; then rm -rf $P ; fi ; mkdir -p $P
  cd $B

  export LDFLAGS='-Wl,--as-needed'
  make install DESTDIR=$P

################################
#      install tweaks
#  strip binaries, delete locale except ja, compress man,
#  install docs and patches, compress them and  chown root.root
################################
  install_tweak

## re-locate html-docs to /usr/share/doc/$src
mkdir $P/usr/share/doc/$src/html
mv $P/usr/share/doc/$pkgbase/* $P/usr/share/doc/$src/html
rmdir $P/usr/share/doc/$pkgbase

## copy FFmpeg.info.sh into $P/usr/share/doc/$src/
cat $W/FFmpeg-info.sh > $P/usr/share/doc/$src/FFmpeg-info.sh
cat $W/ffmpeg_command-Tips.md > $P/usr/share/doc/$src/ffmpeg_command-Tips.md

#############################
#   convert symlink to null file and
#   add "ln -sf" command into install/doinst.sh
################################
  convert_links

  cd $P
  /sbin/makepkg ../$pkg.$compress <<EOF
y
1
EOF

fi
