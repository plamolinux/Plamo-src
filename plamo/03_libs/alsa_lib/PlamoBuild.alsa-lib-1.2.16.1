#!/bin/sh
##############################################################
pkgbase="alsa_lib"
vers="1.2.16.1"
topology_conf_vers="1.2.5.1"
url="https://www.alsa-project.org/files/pub/lib/alsa-lib-${vers}.tar.bz2"
verify=""
digest="https://www.alsa-project.org/files/pub/lib/alsa-lib-${vers}.tar.bz2.sig"
arch=`uname -m`
build=B1
src="alsa-lib-${vers}"
OPT_CONFIG="--disable-static --enable-shared --enable-mixer-modules --enable-topology --enable-ucm"
DOCS="COPYING ChangeLog INSTALL TODO doc"
patchfiles=""
# specifies files that are not in source archive and patchfiles
# https://ftp.osuosl.org/pub/slackware/slackware64-current/source/l/alsa-lib/alsa-topology-conf-1.2.5.1.tar.lz
# https://ftp.osuosl.org/pub/slackware/slackware64-current/source/l/alsa-lib/alsa-ucm-conf-1.2.16.1.tar.lz
addfiles="asound.conf.pulse smixer.conf alsa-topology-conf-${topology_conf_vers}.tar.lz alsa-ucm-conf-${vers}.tar.lz makepkg.tst"
compress=tzst
##############################################################

source /usr/share/plamobuild_functions.sh

# このスクリプトで使う1文字変数の意味
#
# $W : このスクリプトを動かすカレントディレクトリ
# $S : ソースコードのあるディレクトリ(デフォルト: $W/${src})
# $B : ビルド用ディレクトリ(デフォルト: /tmp/build)
# $P : ビルドしたファイルをインストールするディレクトリ（デフォルト: $W/work)

if [ $# -eq 0 ] ; then
  opt_download=0 ; opt_config=1 ; opt_build=1 ; opt_package=1
else
  opt_download=0 ; opt_config=0 ; opt_build=0 ; opt_package=0
  for i in $@ ; do
    case $i in
    download) opt_download=1 ;;
    config) opt_config=1 ;;
    build) opt_build=1 ;;
    package) opt_package=1 ;;
    esac
  done
fi
if [ $opt_download -eq 1 ] ; then
    download_sources

    wget -N https://ftp.osuosl.org/pub/slackware/slackware64-current/source/l/alsa-lib/alsa-topology-conf-${topology_conf_vers}.tar.lz
    wget -N https://ftp.osuosl.org/pub/slackware/slackware64-current/source/l/alsa-lib/alsa-ucm-conf-${vers}.tar.lz
    wget -N https://ftp.osuosl.org/pub/slackware/slackware64-current/source/l/alsa-lib/asound.conf.pulse
    wget -N https://ftp.osuosl.org/pub/slackware/slackware64-current/source/l/alsa-lib/smixer.conf
fi


if [ $opt_config -eq 1 ] ; then

    for f in $addfiles $patchfiles
    do
        if [ ! -f $f ]; then
            echo "Required file ($f) is missing."
            exit 255
        fi
    done

######################################################################
#  out of tree build. patch apply in src dir
######################################################################
    if [ -d $B ] ; then rm -rf $B ; fi ; cp -a $S $B
    cd $B
    for patch in $patchfiles ; do
        if [ ! -f .${patch} ]; then
            patch -p1 < $W/$patch
            touch .${patch}
        fi
    done

# Untar the configuration files. We'll install them later.
( mkdir ucm-and-topology-configs
  cd ucm-and-topology-configs
  for file in $W/alsa-*conf*tar.lz ; do
    tar xvf $file
    mv $(basename $file | cut -f 1-3 -d -)-*/* .
    rmdir $(basename $file | cut -f 1-3 -d -)-*
    mv README.md README-$(echo $(basename $file) | cut -f 1-3 -d -)
  done
) || exit 1

    cp -a $W/smixer.conf src/conf

    # if [ -f autogen.sh ] ; then
    #   sh ./autogen.sh
    # fi

    export PKG_CONFIG_PATH=/usr/${libdir}/pkgconfig:/usr/share/pkgconfig
    export LDFLAGS='-Wl,--as-needed' 
    ./configure --prefix=/usr --libdir=/usr/${libdir} --sysconfdir=/etc --localstatedir=/var --mandir=/usr/share/man ${OPT_CONFIG}
    if [ $? != 0 ]; then
        echo "configure error. $0 script stop"
        exit 255
    fi
fi

if [ $opt_build -eq 1 ] ; then
    cd $B 
    export LDFLAGS='-Wl,--as-needed'
    NUMJOBS=${NUMJOBS:-" -j$(expr $(nproc) + 1) "}
    make $NUMJOBS
    if [ $? != 0 ]; then
        echo "build error. $0 script stop"
        exit 255
    fi
fi

if [ $opt_package -eq 1 ] ; then
  check_root
  if [ -d $P ] ; then rm -rf $P ; fi ; mkdir -p $P
  cd $B

  export LDFLAGS='-Wl,--as-needed'
  make install DESTDIR=$P

mkdir -p $P/etc
cp -a $W/asound.conf.pulse $P/etc/asound.conf.new

chmod 644 $P/etc/asound.conf.new

# Install ucm and topology configs:
( cd ucm-and-topology-configs ; tar cf - . ) | ( cd $P/usr/share/alsa ; tar xf -)
if [ "$(id -u)" -eq 0 ]; then
  chown root:root $P/etc/asound.conf.new
  chown -R root:root $P/usr/share/alsa
fi

################################
#      install tweaks
#  strip binaries, delete locale except ja, compress man,
#  install docs and patches, compress them and  chown root.root
################################
  install_tweak

cp $W/asound.conf.pulse $P/usr/share/doc/$src
cp $W/smixer.conf $P/usr/share/doc/$src

for i in $addfiles ; do
    cp $W/$i $P/usr/share/doc/$src
done

#############################
#   convert symlink to null file and
#   add "ln -sf" command into install/doinst.sh
################################
  convert_links

  cd $P
  # need special makepkg to quote linknames which have space characters
  $W/makepkg.tst ../$pkg.$compress <<EOF
y
1
EOF

fi
