#!/bin/sh
##############################################################
pkgbase="libieee1284"
vers="0.2.11"
url="https://altushost-swe.dl.sourceforge.net/project/libieee1284/libieee1284/0.2.11/libieee1284-0.2.11.tar.bz2"
verify=""
digest=""
arch=`uname -m`
build=B4
src="libieee1284-0.2.11"
OPT_CONFIG="--disable-static --enable-shared"
DOCS="AUTHORS COPYING ChangeLog INSTALL NEWS README README.FreeBSD README.OpenBSD README.Solaris README.VC6 README.win95 README.winNT TODO doc"

# https://github.com/archlinux/svntogit-packages/raw/packages/libieee1284/trunk/upstream_python_fix1.patch
# https://github.com/archlinux/svntogit-packages/raw/packages/libieee1284/trunk/upstream_python_fix2.patch
# fix-python-3-compatibility.patch(https://github.com/twaugh/libieee1284/commit/357005f6b19c4e2febd3c0f17e59de541accbe92.patch)
# fix-python-3.12-compatibility.patch(https://github.com/twaugh/libieee1284/commit/cf59766dd848bd8b4318b1c67b5df053903ddefb.patch)
patchfiles="upstream_python_fix1.patch upstream_python_fix2.patch fix-python-3-compatibility.patch fix-python-3.12-compatibility.patch"
# specifies files that are not in source archive and patchfiles
addfiles=""
compress=tzst
##############################################################

source /usr/share/plamobuild_functions.sh

# このスクリプトで使う1文字変数の意味
#
# $W : このスクリプトを動かすカレントディレクトリ
# $S : ソースコードのあるディレクトリ(デフォルト: $W/${src})
# $B : ビルド用ディレクトリ(デフォルト: /tmp/build)
# $P : ビルドしたファイルをインストールするディレクトリ（デフォルト: $W/work)

if [ $# -eq 0 ] ; then
  opt_download=0 ; opt_config=1 ; opt_build=1 ; opt_package=1
else
  opt_download=0 ; opt_config=0 ; opt_build=0 ; opt_package=0
  for i in $@ ; do
    case $i in
    download) opt_download=1 ;;
    config) opt_config=1 ;;
    build) opt_build=1 ;;
    package) opt_package=1 ;;
    esac
  done
fi
if [ $opt_download -eq 1 ] ; then
    download_sources
fi


if [ $opt_config -eq 1 ] ; then

    for f in $addfiles $patchfiles
    do
        if [ ! -f $f ]; then
            echo "Required file ($f) is missing."
            exit 255
        fi
    done

######################################################################
#  copy source build. patch apply in build dir
######################################################################
    if [ -d $B ] ; then rm -rf $B ; fi ; cp -a $S $B 
    cd $B
    for patch in $patchfiles ; do
        if [ ! -f .${patch} ]; then
            patch -p1 -F3 < $W/$patch
            touch .${patch}
        fi
    done
    # if [ -f autogen.sh ] ; then
    #   sh ./autogen.sh
    # fi
    cd $B
    export PKG_CONFIG_PATH=/usr/${libdir}/pkgconfig:/usr/share/pkgconfig
    export LDFLAGS='-Wl,--as-needed' 
    ./configure --prefix=/usr --libdir=/usr/${libdir} --sysconfdir=/etc --localstatedir=/var --mandir=/usr/share/man ${OPT_CONFIG}

    sed -i -e "s|CPPFLAGS = |CPPFLAGS = -I/usr/include/python3.14|" \
	-e "s|python/site-packages|python3.14/site-packages|" Makefile
    
    if [ $? != 0 ]; then
        echo "configure error. $0 script stop"
        exit 255
    fi
fi

if [ $opt_build -eq 1 ] ; then
    cd $B 
    export LDFLAGS='-Wl,--as-needed'
    make -j3
    if [ $? != 0 ]; then
        echo "build error. $0 script stop"
        exit 255
    fi
fi

if [ $opt_package -eq 1 ] ; then
  check_root
  if [ -d $P ] ; then rm -rf $P ; fi ; mkdir -p $P
  cd $B

  export LDFLAGS='-Wl,--as-needed'
  make install DESTDIR=$P

################################
#      install tweaks
#  strip binaries, delete locale except ja, compress man,
#  install docs and patches, compress them and  chown root.root
################################
  install_tweak

#############################
#   convert symlink to null file and
#   add "ln -sf" command into install/doinst.sh
################################
  convert_links

  cd $P
  /sbin/makepkg ../$pkg.$compress <<EOF
y
1
EOF

fi
