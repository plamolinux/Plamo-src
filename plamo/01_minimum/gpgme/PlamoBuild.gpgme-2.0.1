#!/bin/sh
##############################################################
pkgbase='gpgme'
vers="2.0.1"
pythonvers="3.14"
url="https://www.gnupg.org/ftp/gcrypt/gpgme/gpgme-${vers}.tar.bz2"
verify="${url}.sig"
arch=`uname -m`
build=B4
src="${pkgbase}-${vers}"
OPT_CONFIG="--disable-static"
DOCS='AUTHORS COPYING COPYING.LESSER ChangeLog ChangeLog-2011 INSTALL NEWS README THANKS TODO'
patchfiles=''
compress=tzst
##############################################################
# compat lib
compat_vers="1.24.3"
compat_url="https://www.gnupg.org/ftp/gcrypt/gpgme/gpgme-${compat_vers}.tar.bz2"
verify=""
compat_digest="md5sum:c6f85ce24ad46c9469596df0301f32eb"
compat_src="gpgme-${compat_vers}"
compat_OPT_CONFIG="--disable-static --enable-languages=python"
compat_patchfiles=""
####

source /usr/share/plamobuild_functions.sh

# このスクリプトで使う1文字変数の意味
#
# $W : このスクリプトを動かすカレントディレクトリ
# $S : ソースコードのあるディレクトリ(デフォルト: $W/${src})
# $B : ビルド用ディレクトリ(デフォルト: /tmp/build{,32})
# $P : ビルドしたファイルをインストールするディレクトリ（デフォルト: $W/work)

#
# function for compat lib
#
compat_download() {
    if [ ! -f ${compat_url##*/} ]; then
	wget $compat_url
    fi
    IFS=":"
    set -- $compat_digest
    sum=$( $1 ${compat_url##*/} | awk '{ print $1 }')
    IFS=$' \t\n'
    if [ $sum != $2 ]; then
	exit 1
    fi
    tar xvf ${compat_url##*/}
}

B_compat="/tmp/build2"

compat_config() {
    for f in $compat_patchfiles
    do
        if [ ! -f $f ]; then
            echo "Required file ($f) is missing."
            exit 255
        fi
    done
    if [ -d $B_compat ] ; then rm -rf $B_compat ; fi ; mkdir -p $B_compat 
    cd $W/$compat_src
    for patch in $compat_patchfiles ; do
        if [ ! -f .${patch} ]; then
            patch -p1 < $W/$patch
            touch .${patch}
        fi
    done
    sed -i "s/3.13/$pythonvers/g" configure
    cd $B_compat
    export LDFLAGS='-Wl,--as-needed'
    $W/$compat_src/configure --prefix=/usr --libdir=/usr/${libdir} --sysconfdir=/etc --localstatedir=/var --mandir=/usr/share/man ${compat_OPT_CONFIG}
    if [ $? != 0 ]; then
        echo "configure error. $0 script stop"
        exit 255
    fi
}

compat_build() {
    cd $B_compat
    export LDFLAGS='-Wl,--as-needed'
    make -j3
    if [ $? != 0 ]; then
        echo "build error. $0 script stop"
        exit 255
    fi
}

P_compat=$W/work2

compat_install() {
  check_root
  if [ -d $P_compat ] ; then rm -rf $P_compat ; fi ; mkdir -p $P_compat
  cd $B_compat

  export LDFLAGS='-Wl,--as-needed'
  make install DESTDIR=$P_compat

  cp -av $P_compat/usr/lib/libgpgme.so.* $P/usr/lib/
  cp -av $P_compat/usr/lib/libgpgmepp.so.* $P/usr/lib/
  cp -av $P_compat/usr/lib/python$pythonvers $P/usr/lib/
}

#
# end: for compat lib
#

if [ $# -eq 0 ] ; then
  opt_download=0 ; opt_config=1 ; opt_build=1 ; opt_package=1
else
  opt_download=0 ; opt_config=0 ; opt_build=0 ; opt_package=0
  for i in $@ ; do
    case $i in
    download) opt_download=1 ;;
    config) opt_config=1 ;;
    build) opt_build=1 ;;
    package) opt_package=1 ;;
    esac
  done
fi
if [ $opt_download -eq 1 ] ; then
    download_sources
    compat_download
fi

B_compat="/tmp/build2"

if [ $opt_config -eq 1 ] ; then
  if [ -d $B ] ; then rm -rf $B ; fi ; mkdir -p $B 
######################################################################
#  don't copy sources, so need patch in the src dir
######################################################################
  cd $S
  for patch in $patchfiles ; do
    if [ ! -f .${patch} ]; then
      patch -p1 < $W/$patch
      touch .${patch}
    fi
  done

  cd $B
  export PKG_CONFIG_PATH=/usr/${libdir}/pkgconfig:/usr/share/pkgconfig:/opt/kde/${libdir}/pkgconfig
  export LDFLAGS='-Wl,--as-needed' 
  $S/configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var --mandir='${prefix}'/share/man ${OPT_CONFIG[$i]}
    
  if [ $? != 0 ]; then
    echo "configure error. $0 script stop"
    exit 255
  fi

  compat_config
fi
    
if [ $opt_build -eq 1 ] ; then
  cd $B
  export LDFLAGS='-Wl,--as-needed'
  make -j3
  if [ $? != 0 ]; then
    echo "build error. $0 script stop"
    exit 255
  fi
  
  compat_build

fi

if [ $opt_package -eq 1 ] ; then
  check_root
  if [ -d $P ] ; then rm -rf $P ; fi ; mkdir -p $P
  cd $B
  export LDFLAGS='-Wl,--as-needed'
  make install DESTDIR=$P

  compat_install

################################
#      install tweaks
#  strip binaries, delete locale except ja, compress man, 
#  install docs and patches, compress them and  chown root.root
################################
  install_tweak

#############################
#   convert symlink to null file and 
#   add "ln -sf" command into install/doinst.sh
################################
  convert_links

  cd $P
  /sbin/makepkg ../$pkg.$compress <<EOF
y
1
EOF

fi
