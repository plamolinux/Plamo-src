#!/bin/sh
##############################################################
pkgbase="xscreensaver"
vers="6.14"
url="https://www.jwz.org/xscreensaver/xscreensaver-${vers}.tar.gz"
verify=""
digest=""
arch=`uname -m`
build=B1
src="xscreensaver-${vers}"
OPT_CONFIG="--with-elogind --datadir=/usr/share --localedir=/usr/share/locale"
DOCS="INSTALL README README.hacking"
patchfiles=""
# specifies files that are not in source archive and patchfiles
addfiles="xscreensaver.pam"
compress=tzst
##############################################################

source /usr/share/plamobuild_functions.sh

# このスクリプトで使う1文字変数の意味
#
# $W : このスクリプトを動かすカレントディレクトリ
# $S : ソースコードのあるディレクトリ(デフォルト: $W/${src})
# $B : ビルド用ディレクトリ(デフォルト: /tmp/build)
# $P : ビルドしたファイルをインストールするディレクトリ（デフォルト: $W/work)

if [ $# -eq 0 ] ; then
  opt_download=0 ; opt_config=1 ; opt_build=1 ; opt_package=1
else
  opt_download=0 ; opt_config=0 ; opt_build=0 ; opt_package=0
  for i in $@ ; do
    case $i in
    download) opt_download=1 ;;
    config) opt_config=1 ;;
    build) opt_build=1 ;;
    package) opt_package=1 ;;
    esac
  done
fi
if [ $opt_download -eq 1 ] ; then
    download_sources
fi

if [ $opt_config -eq 1 ] ; then

    for f in $addfiles $patchfiles
    do
        if [ ! -f $f ]; then
            echo "Required file ($f) is missing."
            exit 255
        fi
    done

######################################################################
#  source copy build. patch apply in build dir
######################################################################
    if [ -d $B ] ; then rm -rf $B ; fi ;  cp -a $S $B  
    cd $B
    for patch in $patchfiles ; do
       patch -p1 < $W/$patch
    done
 
    # Generate POT file for translators
    cd po && intltool-update --verbose -p && cd ..

    # Fix man pages header:
    find hacks -name '*.man' -print0 | xargs -0 sed -ie 's/TH XScreenSaver 1/TH XScreenSaver 6/'

    sed -re '
        s/^([[:space:]]*(rorschach|greynetic|deco|moire|mountain|triangle|worm|xlyap|cynosure|bsod|phosphor|blaster|fluidballs|barcode))/-\1/;
        s/^@GL_KLUDGE@([[:space:]]*GL:[[:space:]]*(sproingies|circuit|atunnel|glmatrix|stairs|pulsar|starwars|boxed|cubenetic|queens|endgame|mapscroller|atlantis|bubble3d|molecule|polyhedra|superquadrics))/-\1/;
        ' driver/XScreenSaver.ad.in > driver/XScreenSaver.ad.in.tmp && mv -f driver/XScreenSaver.ad.in.tmp driver/XScreenSaver.ad.in

    intltoolize --copy --force

    export ACLOCAL_PATH=/usr/share/aclocal:/usr/share/gettext/m4
    autoreconf -fi

    # if [ -f autogen.sh ] ; then
    #   sh ./autogen.sh
    # fi

    export PKG_CONFIG_PATH=/usr/${libdir}/pkgconfig:/usr/share/pkgconfig
    export LDFLAGS='-Wl,--as-needed' 
    ./configure --prefix=/usr --libdir=/usr/${libdir} --sysconfdir=/etc --localstatedir=/var --mandir=/usr/share/man ${OPT_CONFIG}
    if [ $? != 0 ]; then
        echo "configure error. $0 script stop"
        exit 255
    fi

    # Fix xscreensaver po Makefile
    sed -i "/all: all-yes/a\default: all" po/Makefile
    sed -i "s|@install_sh@|../install-sh -c|" po/Makefile
fi

if [ $opt_build -eq 1 ] ; then
    cd $B 
    export LDFLAGS='-Wl,--as-needed'
    make -j$(nproc)
    if [ $? != 0 ]; then
        echo "build error. $0 script stop"
        exit 255
    fi
fi

if [ $opt_package -eq 1 ] ; then
  check_root
  if [ -d $P ] ; then rm -rf $P ; fi ; mkdir -p $P
  cd $B

  export LDFLAGS='-Wl,--as-needed'
  make install install_prefix=$P DESTDIR=$P

  cd po
  make install-data DESTDIR=$P
  cd ..

  find $P -print0 | xargs -0 file | grep -e "executable" -e "shared object" | grep ELF \
    | cut -f 1 -d : | xargs strip --strip-unneeded 2> /dev/null || true

  install -v -Dm644 $W/xscreensaver.pam $P/etc/pam.d/xscreensaver
  install -v -Dm644 $W/xscreensaver.pam $docdir/$src/xscreensaver.pam
  
  mkdir -p $P/install
  cat << "EOF" > $P/install/initpkg
gtk-update-icon-cache --force --quiet /usr/share/icons/Adwaita
gtk-update-icon-cache --force --quiet /usr/share/icons/gnome
gtk-update-icon-cache --force --quiet /usr/share/icons/hicolor
EOF
################################
#      install tweaks
#  strip binaries, delete locale except ja, compress man,
#  install docs and patches, compress them and  chown root.root
################################
  install_tweak

#############################
#   convert symlink to null file and
#   add "ln -sf" command into install/doinst.sh
################################
  convert_links

  cd $P
  /sbin/makepkg ../$pkg.$compress <<EOF
y
1
EOF

fi
