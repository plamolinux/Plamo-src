# Dovecot sample configration for plamo
# This is SAMPLE.
# Please refer to https://doc.dovecot.org/latest/ and configure it appropriately
dovecot_config_version = ##dovecot_version##
dovecot_storage_version = ##dovecot_version##

protocols = imap
ssl = no
auth_allow_cleartext = yes

listen = *
mail_driver = maildir
mail_path = ~/Maildir

userdb users {
       driver	= passwd
}

passdb passwords {
       driver	= pam
}
