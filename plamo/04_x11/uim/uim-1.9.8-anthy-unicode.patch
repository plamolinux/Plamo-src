--- uim-1.9.8.orig/configure.ac	2026-09-23 21:56:37.000000000 +0900
+++ uim-1.9.8/configure.ac	2026-09-24 08:28:40.507099252 +0900
@@ -112,21 +112,21 @@ AC_ARG_WITH(anthy,
   [with_anthy=yes])
 
 if test "x$with_anthy" != xno; then
-  AC_CHECK_HEADERS([anthy/anthy.h],
+  AC_CHECK_HEADERS([anthy-unicode-1.0/anthy/anthy.h],
     [
       saved_LIBS=$LIBS
-      LIBS="$LIBS -lanthy -lanthydic"
-      AC_CHECK_LIB([anthy], [anthy_init], [with_anthy=yes], [with_anthy=no])
+      LIBS="$LIBS -lanthy-unicode -lanthydic-unicode"
+      AC_CHECK_LIB([anthy-unicode], [anthy_init], [with_anthy=yes], [with_anthy=no])
       LIBS=$saved_LIBS
     ],
     [with_anthy=no])
 fi
 
 if test "x$with_anthy" = xyes; then
-  ANTHY_LIBS="-lanthy -lanthydic"
+  ANTHY_LIBS="-lanthy-unicode -lanthydic-unicode"
   ANTHY_CFLAGS=""
   PKG_CHECK_EXISTS(
-    anthy >= 8622,
+    anthy-unicode >= 1.0.0.20211224,
     [AC_DEFINE(LIBANTHY_UTF8_CAPABLE, 1, "libanthy can handle UTF-8")],
     [PKG_CHECK_EXISTS(
        anthy < 1000, # https://salsa.debian.org/debian/anthy supports UTF-8.
@@ -148,7 +148,7 @@ AC_ARG_WITH(anthy-utf8,
 if test "x$with_anthy_utf8" != xno; then
   PKG_CHECK_MODULES(
     ANTHY_UTF8,
-    anthy-unicode,
+    anthy-unicode >= 1.0.0.20211224,
     [with_anthy_utf8=yes
      AC_DEFINE(LIBANTHY_UTF8_CAPABLE, 1,
      [libanthy-unicode can handle UTF-8])],
