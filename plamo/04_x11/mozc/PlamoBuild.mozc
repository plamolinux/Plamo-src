#!/bin/sh
##############################################################
pkgbase="mozc"
vers="3.33.6089.2"
commitid="e99761585"
url="https://github.com/fcitx/mozc.git"
verify=""
digest=""
arch=`uname -m`
build=B1
src="mozc"
#OPT_CONFIG="--disable-static --enable-shared"
DOCS="AUTHORS LICENSE README.md docker docs"
patchfiles="mozc.patch bazel.patch macuim_mozc_tool.patch yoshizawa.patch"
# specifies files that are not in source archive and patchfiles
addfiles="BUILD.bazel LICENSE.japanese-zip-code-dictionary README.v2.0.generate-zipcode-dic generate-zipcode-dic.sh jigyosyo-convert-mozc-dictionary.awk ken_all-convert-mozc-dictionary.awk"
compress=tzst

# mozc-ut(arch linux)
breakpad_commit="216cea7bca53fa441a3ee0d0f5fd339a3a894224"
googletest_commit="52eb8108c5bdec04579160ae17225d66034bd723"
gyp_commit="9ecf45e37677743503342ee4c6a76eaee80e4a7f"
japanese_usage_dictionary_commit="e5b3425575734c323e1d947009dd74709437b684"
wil_commit="fc5dbf55989fe20351c71d038a8d12de4b397a6d"
protobuf_commit="4fbd1111a292d04746c732573025e3251de0bb9c"
abseil_cpp_commit="987c57f325f7fa8472fa84e1f885f7534d391b0d"
merge_ut_dictionaries_commit="9c30e6648ccf459ef364529f21b029932ac6c455"
mozcdic_ut_alt_cannadic_commit="69d40eed4e9cf016384d9629920fefa199116ea2"
mozcdic_ut_edict2_commit="5e2db4eccab42652ae29e798b267c0f50f101128"
mozcdic_ut_jawiki_commit="f7ad6d689be3c5dc33bef6ae1620bb618a0f12fc"
mozcdic_ut_neologd_commit="e33ac4ce808fa4253c6c97bf5178e229a4bfb50f"
mozcdic_ut_personal_names_commit="a2e43ea4d2c93ef8730a73df503c046a465294d3"
mozcdic_ut_place_names_commit="3c054fa8e849f6da5b76ec99f8fc28d555ef5c63"
mozcdic_ut_skk_jisyo_commit="384ad926e306d5308839c6dedb63696f11703968"
mozcdic_ut_sudachidict_commit="6c8307cb6c8a935707fd7c39f5d116300e7b8d87"
bazel_central_registry_commit="b340ca17233d8a3452184a0bf5f593000cdad9e4"

# uim-mozc(arch linux)
uimmozcrev="7beac7ba000e0459a4dc933f3873b521664d2665"

# mozc-ut(arch linux)
jawiki_date="20260201"

# fcitx5-mozc-ext-neologd(arch linux)
dictext_commit="574160e"
neologd_commit="abc61e3"
##############################################################

source /usr/share/plamobuild_functions.sh

B=$W/build

# このスクリプトで使う1文字変数の意味
#
# $W : このスクリプトを動かすカレントディレクトリ
# $S : ソースコードのあるディレクトリ(デフォルト: $W/${src})
# $B : ビルド用ディレクトリ(デフォルト: /tmp/build)
# $P : ビルドしたファイルをインストールするディレクトリ（デフォルト: $W/work)

if [ $# -eq 0 ] ; then
  opt_download=0 ; opt_config=1 ; opt_build=1 ; opt_package=1
else
  opt_download=0 ; opt_config=0 ; opt_build=0 ; opt_package=0
  for i in $@ ; do
    case $i in
    download) opt_download=1 ;;
    config) opt_config=1 ;;
    build) opt_build=1 ;;
    package) opt_package=1 ;;
    esac
  done
fi
if [ $opt_download -eq 1 ] ; then
    download_sources

    git clone https://chromium.googlesource.com/breakpad/breakpad
    cd breakpad
    git checkout -b build $breakpad_commit

    cd $W
    git clone https://github.com/google/googletest.git
    cd googletest
    git checkout -b build $googletest_commit

    cd $W
    git clone https://chromium.googlesource.com/external/gyp
    cd gyp
    git checkout -b build $gyp_commit

    cd $W
    git clone https://github.com/hiroyuki-komatsu/japanese-usage-dictionary.git
    cd japanese-usage-dictionary
    git checkout -b build $japanese_usage_dictionary_commit

    cd $W
    git clone https://github.com/microsoft/wil.git
    cd wil
    git checkout -b build $wil_commit

    cd $W
    git clone https://github.com/google/protobuf.git
    cd protobuf
    git checkout -b build $protobuf_commit

    cd $W
    git clone https://github.com/abseil/abseil-cpp.git
    cd abseil-cpp
    git checkout -b build $abseil_cpp_commit

    cd $W
    git clone https://github.com/e-kato/macuim.git
    cd macuim
    git checkout -b build $uimmozcrev

    cd $W
    git clone https://github.com/reasonset/mozcdict-ext.git
    cd mozcdict-ext
    git checkout -b build ${dictext_commit}

    cd $W
    git clone https://github.com/neologd/mecab-ipadic-neologd.git
    cd mecab-ipadic-neologd
    git checkout -b build ${neologd_commit}

    cd $W
    git clone https://github.com/utuhiro78/merge-ut-dictionaries.git
    cd merge-ut-dictionaries
    git checkout -b build ${merge_ut_dictionaries_commit}

    cd $W
    git clone https://github.com/utuhiro78/mozcdic-ut-alt-cannadic.git
    cd mozcdic-ut-alt-cannadic
    git checkout -b build ${mozcdic_ut_alt_cannadic_commit}
    
    cd $W
    git clone https://github.com/utuhiro78/mozcdic-ut-edict2.git
    cd mozcdic-ut-edict2
    git checkout -b build ${mozcdic_ut_edict2_commit}
    
    cd $W
    git clone https://github.com/utuhiro78/mozcdic-ut-jawiki.git
    cd mozcdic-ut-jawiki
    git checkout -b build ${mozcdic_ut_jawiki_commit} 
    
    cd $W
    git clone https://github.com/utuhiro78/mozcdic-ut-neologd.git
    git mozcdic-ut-neologd
    git checkout -b build ${mozcdic_ut_neologd_commit}
    
    cd $W
    git clone https://github.com/utuhiro78/mozcdic-ut-personal-names.git
    cd mozcdic-ut-personal-names
    git checkout -b build ${mozcdic_ut_personal_names_commit}
    
    cd $W
    git clone https://github.com/utuhiro78/mozcdic-ut-place-names.git
    cd mozcdic-ut-place-names
    git checkout -b build ${mozcdic_ut_place_names_commit}
    
    cd $W
    git clone https://github.com/utuhiro78/mozcdic-ut-skk-jisyo.git
    cd mozcdic-ut-skk-jisyo
    git checkout -b build ${mozcdic_ut_skk_jisyo_commit}
    
    cd $W
    git clone https://github.com/utuhiro78/mozcdic-ut-sudachidict.git
    cd mozcdic-ut-sudachidict
    git checkout -b build ${mozcdic_ut_sudachidict_commit}

    cd $W
    git clone https://github.com/bazelbuild/bazel-central-registry.git
    cd bazel-central-registry
    git checkout -b build ${bazel_central_registry_commit}

    cd $S
    git submodule init
    git config submodule.src/third_party/breakpad.url $W/breakpad
    git config submodule.src/third_party/gtest.url $W/googletest
    git config submodule.src/third_party/gyp.url $W/gyp
    git config submodule.src/third_party/japanese_usage_dictionary.url $W/japanese-usage-dictionary   
    git config submodule.src/third_party/wil.url $W/wil
    git config submodule.src/third_party/protobuf.url $W/protobuf
    git config submodule.src/third_party/abseil-cpp.url $W/abseil-cpp
    git -c protocol.file.allow=always submodule update

    cd src

    # Reset dictionary09
    git checkout data/dictionary_oss/dictionary09.txt

    # Include NEologd
    cd $W/mozcdict-ext

    git submodule init
    git config submodule.neologd/upstream.url $W/mecab-ipadic-neologd
    git -c protocol.file.allow=always submodule update

    cd $W
    wget --timestamping https://dumps.wikimedia.org/jawiki/${jawiki_date}/jawiki-${jawiki_date}-pages-articles-multistream-index.txt.bz2
    wget --timestamping https://www.post.japanpost.jp/zipcode/dl/jigyosyo/zip/jigyosyo.zip
    unzip jigyosyo.zip
    wget --timestamping https://www.post.japanpost.jp/zipcode/dl/oogaki/zip/ken_all.zip
    unzip ken_all.zip
fi

if [ $opt_config -eq 1 ] ; then
    if [ -d $B ] ; then rm -rf $B ; fi ;  cp -a $S $B  
    for f in $addfiles $patchfiles
    do
        if [ ! -f $f ]; then
            echo "Required file ($f) is missing."
            exit 255
        fi
    done

    set -e

    cd $W/macuim
    if [ ! -f .macuim_mozc_tool.patch ]; then
        patch -p1 < $W/macuim_mozc_tool.patch
        touch .macuim_mozc_tool.patch
    fi

    if [ ! -f .yoshizawa.patch ]; then
        patch -p1 < $W/yoshizawa.patch
        touch .yoshizawa.patch
    fi


    cd $B/src
    echo "prepare uim-mozc"
    cp -rf "$W/macuim/Mozc/uim" unix/
    cp $W/BUILD.bazel unix/uim

    cd $B
    patch -p1 -i $W/bazel.patch
    cd $B/src
    patch -p1 -i $W/mozc.patch

    echo "Generating zip code seed..."
    cd $B/src
    echo "Reset dictionary09"
    git checkout data/dictionary_oss/dictionary09.txt

    PYTHONPATH="$PWD:$PYTHONPATH" python dictionary/gen_zip_code_seed.py --zip_code="$W/KEN_ALL.CSV" --jigyosyo="$W/JIGYOSYO.CSV" >> data/dictionary_oss/dictionary09.txt
    echo "Done."

    cd $W/mozcdict-ext
    echo "Generating extra dictionaries..."
    (
      (
        cd neologd
        MOZC_ID_FILE="$B/src/data/dictionary_oss/id.def" zsh mkdict.zsh
      )
      (
        cd sudachi
        MOZC_ID_FILE="$B/src/data/dictionary_oss/id.def" zsh mkdict.zsh
      )
      (
        cd byhand
        MOZC_ID_FILE="$B/src/data/dictionary_oss/id.def" zsh mkdict.zsh
      )
    ) | ruby .dev.utils/uniqword.rb 2> /dev/null >> "$B/src/data/dictionary_oss/dictionary09.txt"
    echo "Done."

    cd $B/src
    rm unix/fcitx/fcitx.gyp

    cd $W/merge-ut-dictionaries/src/merge/
    echo "Use a dated snapshot for the jawiki dump data"
    if [ ! -e .already_sed_merge_dictionaries ];then
	sed -i -e '124,127d' merge_dictionaries.py
	sed -i -e "s|jawiki-[a-z0-9]\{6,8\}|$W/jawiki-${jawiki_date}|g" merge_dictionaries.py

    	echo "Use our local copy of the Mozc repo"
        sed -i -e "65s|os\.path\.exists(f'mozc-{date}.zip')|False|" merge_dictionaries.py
        sed -i -e '71s|zip_ref\.||' merge_dictionaries.py
        sed -i -e "72s|mozc-master/src/data/dictionary_oss/id\.def|$W/mozc/src/data/dictionary_oss/id\.def|" merge_dictionaries.py
        sed -i -e '74s|id_mozc\.|file\.read()\.|' merge_dictionaries.py
        sed -i -e '80s|zip_ref\.||' merge_dictionaries.py
        sed -i -e "81s|mozc-master/src/data/dictionary_oss/|$W/mozc/src/data/dictionary_oss/|" merge_dictionaries.py
        sed -i -e '83s|decode()\.||' merge_dictionaries.py
        sed -i -e '53,64d;66,69d;73d' merge_dictionaries.py
	touch .already_sed_merge_dictionaries
    fi

    # Compile the UT dictionary
    ENABLED_DICTIONARIES=(
    'alt-cannadic'
    'edict2'
    'jawiki'
    'neologd'
    'personal-names'
    'place-names'
    'skk-jisyo'
    'sudachidict'
    )

    printf '\nCompiling the UT dictionary...\n\n'
    [[ -e mozcdic-ut.txt ]] && rm mozcdic-ut.txt

    for dict in "${ENABLED_DICTIONARIES[@]}"
    do
        bzip2 -dfk $W/mozcdic-ut-${dict}/mozcdic-ut-${dict}.txt.bz2
        cat $W/mozcdic-ut-${dict}/mozcdic-ut-${dict}.txt >> mozcdic-ut.txt
    done

    python merge_dictionaries.py mozcdic-ut.txt

    echo "Append the UT dictionary"
    cat mozcdic-ut.txt >> $B/src/data/dictionary_oss/dictionary00.txt    

    set +e
fi

if [ $opt_build -eq 1 ] ; then
    cd $B/src 

    unset ANDROID_NDK_HOME
    unset ANDROID_HOME
    export JAVA_HOME='/usr/java/jdk-22.0.2'
    export PATH=$JAVA_HOME/bin:$PATH

    set -e
    bazel build \
	--registry file://$W/bazel-central-registry \
	--distdir=$W \
        --config oss_linux \
	--config stable_channel \
	--config release_build \
	--copt '-U_FORTIFY_SOURCE' \
        --compilation_mode opt \
	--cxxopt='-Wno-uninitialized -I/usr/include/uim' \
	--host_cxxopt='-Wno-uninitialized -I/usr/include/uim' \
	--experimental_cc_shared_library \
	--verbose_failures \
        unix/fcitx5:fcitx5-mozc.so \
        server:mozc_server \
        gui/tool:mozc_tool \
	unix/uim:uim-mozc \
	unix/icons

    set +e
fi

if [ $opt_package -eq 1 ] ; then
  check_root

# mozc
  if [ -d $P ] ; then rm -rf $P ; fi ; mkdir -p $P
  cd $B/src

  # BSD-3-Clause
  sed -n 67,94p data/installer/credits_en.html > Mozc
  install -Dm644 Mozc $docdir/mozc/Mozc
  # BSD-3-Clause
  sed -n 317,344p data/installer/credits_en.html > Breakpad
  install -Dm644 Breakpad $docdir/mozc/Breakpad
  # NAIST-2003
  sed -n 355,424p data/installer/credits_en.html > IPAdic
  install -Dm644 IPAdic $docdir/mozc/IPAdic
  # BSD-2-Clause
  sed -n 435,457p data/installer/credits_en.html > Japanese-Usage-Dictionary
  install -Dm644 Japanese-Usage-Dictionary $docdir/mozc/Japanese-Usage-Dictionary
  # Public Domain Data
  sed -n 468,470p data/installer/credits_en.html > Okinawa-Dictionary
  install -Dm644 Okinawa-Dictionary $docdir/mozc/Okinawa-Dictionary
  # BSD-3-Clause
  sed -n 481,513p data/installer/credits_en.html > Protocol-Buffers
  install -Dm644 Protocol-Buffers $docdir/mozc/Protocol-Buffers
  # MIT
  sed -n 698,704p data/installer/credits_en.html > Tamachi-Phonetic-Kanji-Alphabet
  install -Dm644 Tamachi-Phonetic-Kanji-Alphabet $docdir/mozc/Tamachi-Phonetic-Kanji-Alphabet
  # MIT
  sed -n 762,782p data/installer/credits_en.html > Windows-Implementation-Library
  sed -i -e 's|^[ \t]*||g' Windows-Implementation-Library
  install -Dm644 Windows-Implementation-Library $docdir/mozc/Windows-Implementation-Library

  cd $B/src
  export PREFIX="$P/usr"
  ../scripts/install_server_bazel

  # gen_zipcode-dic_
  install -Dm755 $W/generate-zipcode-dic.sh $P/usr/lib/mozc/tools/generate-zipcode-dic.sh
  install -Dm644 $W/jigyosyo-convert-mozc-dictionary.awk $P/usr/lib/mozc/tools/jigyosyo-convert-mozc-dictionary.awk
  install -Dm644 $W/ken_all-convert-mozc-dictionary.awk $P/usr/lib/mozc/tools/ken_all-convert-mozc-dictionary.awk

  if [ ! -d $P/usr/bin ];then
	mkdir $P/usr/bin
  fi
  cd $P/usr/bin
  ln -s ../lib/mozc/tools/generate-zipcode-dic.sh generate-zipcode-dic
  cd $B/src

  install -Dm644 $W/LICENSE.japanese-zip-code-dictionary $docdir/mozc/japanese-zip-code-dictionary
  install -Dm644 $W/LICENSE.japanese-zip-code-dictionary $P/usr/lib/mozc/LICENSE

  install -Dm644 $W/README.v2.0.generate-zipcode-dic $docdir/mozc/README.v2.0.generate-zipcode-dic

  # install addfiles
  for add in $addfiles ; do
    cp $W/$add $docdir/mozc/$add
    gzip $docdir/mozc/$add
  done

################################
#      install tweaks
#  strip binaries, delete locale except ja, compress man,
#  install docs and patches, compress them and  chown root.root
################################
  install_tweak

#############################
#   convert symlink to null file and
#   add "ln -sf" command into install/doinst.sh
################################
  convert_links

  cd $P
  /sbin/makepkg ../$pkg.$compress <<EOF
y
1
EOF

# uim_mozc
  cd $B/src
  if [ -d $P ] ; then rm -rf $P ; fi ; mkdir -p $P
  install -D -m 755 bazel-bin/unix/uim/libuim-mozc.so "$P/usr/lib/uim/plugin/libuim-mozc.so"
  install -d "$P/usr/share/uim"
  install    -m 644 $W/macuim/Mozc/scm/*.scm "$P/usr/share/uim/"
  install -D -m 644 data/images/unix/ime_product_icon_opensource-32.png "$P/usr/share/uim/pixmaps/mozc.png"
  install    -m 644 data/images/unix/ui-tool.png "$P/usr/share/uim/pixmaps/mozc_tool_selector.png"
  install    -m 644 data/images/unix/ui-properties.png "$P/usr/share/uim/pixmaps/mozc_tool_config_dialog.png"
  install    -m 644 data/images/unix/ui-dictionary.png "$P/usr/share/uim/pixmaps/mozc_tool_dictionary_tool.png"

  mkdir -p $docdir/uim-mozc
  head -n 32 unix/uim/mozc.cc > $docdir/uim-mozc/LICENSE

  mkdir -p $P/install
  cat <<"EOF" > $P/install/initpkg
if [ -x /usr/bin/uim-module-manager ]; then
        uim-module-manager --register mozc
fi
EOF

  install_tweak
  convert_links

  cd $P
  /sbin/makepkg ../uim_mozc-$vers-$arch-$build.$compress <<EOF
y
1
EOF

# fcitx5_mozc
  cd $B/src
  if [ -d $P ] ; then rm -rf $P ; fi ; mkdir -p $P

  export PREFIX="$P/usr"
  ../scripts/install_fcitx5_bazel

  install_tweak
  convert_links

  cd $P
  /sbin/makepkg ../fcitx5_mozc-$vers-$arch-$build.$compress <<EOF
y
1
EOF
 
# emacs_mozc
  cd $B/src
  if [ -d $P ] ; then rm -rf $P ; fi ; mkdir -p $P

  install -Dm755 bazel-bin/unix/emacs/mozc_emacs_helper "$P"/usr/bin/mozc_emacs_helper
  install -Dm644 unix/emacs/mozc.el "$P"/usr/share/emacs/site-lisp/mozc.el

  install_tweak
  convert_links

  cd $P
  /sbin/makepkg ../emacs_mozc-$vers-$arch-$build.$compress <<EOF
y
1
EOF
 
fi
