#!/bin/sh
##############################################################
pkgbase="mozc"
vers="3.34.6345.2"
commitid="13ef96d765703805f57f7b1e6cd238e959640282"
url="https://github.com/fcitx/mozc.git"
verify=""
digest=""
arch=`uname -m`
build=B1
src="mozc"
#OPT_CONFIG="--disable-static --enable-shared"
DOCS="AUTHORS LICENSE README.md docker docs"
patchfiles="qt-6.12.0.patch"
# specifies files that are not in source archive and patchfiles
addfiles="LICENSE.japanese-zip-code-dictionary README.v2.0.generate-zipcode-dic generate-zipcode-dic.sh jigyosyo-convert-mozc-dictionary.awk ken_all-convert-mozc-dictionary.awk"
compress=tzst

# fcitx5-mozc (Arch Linux)
_mozc_commit=$commitid
_bcr_commit=b0cb0e8ec70689252e3b35f109ffa4a32329b900

_bazel_bin_ver="9.0.2"
_bazel_bin_url="https://github.com/bazelbuild/bazel/releases/download/${_bazel_bin_ver}/bazel-${_bazel_bin_ver}-linux-x86_64"

# fcitx5-mozc-ext-neologd (Arch Linux)
_abseil_cpp_commit=5c01794
_breakpad_commit=8be0e31
_gtest_commit=d72f9c8
_japanese_usage_dictionary_commit=38d3462
_jsoncpp_commit=ca98c98
_protobuf_commit=199a436
_dictext_commit=b1b79e9
_neologd_commit=abc61e3

_bazel_deps=(
    https://github.com/abseil/abseil-cpp/releases/download/20260107.1/abseil-cpp-20260107.1.tar.gz
    https://github.com/abseil/abseil-py/archive/refs/tags/v2.1.0.tar.gz
    https://github.com/astral-sh/python-build-standalone/releases/download/20251031/cpython-3.11.14+20251031-aarch64-unknown-linux-gnu-install_only.tar.gz
    https://github.com/astral-sh/python-build-standalone/releases/download/20251031/cpython-3.11.14+20251031-x86_64-unknown-linux-gnu-install_only.tar.gz
    https://github.com/bats-core/bats-core/archive/v1.10.0.tar.gz
    https://github.com/bazel-contrib/bazel-lib/releases/download/v2.22.5/bazel-lib-v2.22.5.tar.gz
    https://github.com/bazel-contrib/bazel-lib/releases/download/v3.0.0/bazel-lib-v3.0.0.tar.gz
    https://github.com/bazel-contrib/bazel_features/releases/download/v1.42.1/bazel_features-v1.42.1.tar.gz
    https://github.com/bazel-contrib/rules_go/releases/download/v0.60.0/rules_go-v0.60.0.zip
    https://github.com/bazel-contrib/rules_python/releases/download/1.9.0/rules_python-1.9.0.tar.gz
    https://github.com/bazel-contrib/tar.bzl/releases/download/v0.5.1/tar.bzl-v0.5.1.tar.gz
    https://github.com/bazelbuild/apple_support/releases/download/2.4.0/apple_support.2.4.0.tar.gz
    https://github.com/bazelbuild/bazel-skylib/releases/download/1.9.0/bazel-skylib-1.9.0.tar.gz
    https://github.com/bazelbuild/platforms/releases/download/1.0.0/platforms-1.0.0.tar.gz
    https://github.com/bazelbuild/rules_android/releases/download/v0.7.1/rules_android-v0.7.1.tar.gz
    https://github.com/bazelbuild/rules_android_ndk/releases/download/v0.1.5/rules_android_ndk-v0.1.5.tar.gz
    https://github.com/bazelbuild/rules_apple/releases/download/4.5.2/rules_apple.4.5.2.tar.gz
    https://github.com/bazelbuild/rules_cc/releases/download/0.2.17/rules_cc-0.2.17.tar.gz
    https://github.com/bazelbuild/rules_java/releases/download/9.3.0/rules_java-9.3.0.tar.gz
    https://github.com/bazelbuild/rules_kotlin/releases/download/v2.2.2/rules_kotlin-v2.2.2.tar.gz
    https://github.com/bazelbuild/rules_license/releases/download/1.0.0/rules_license-1.0.0.tar.gz
    https://github.com/bazelbuild/rules_pkg/releases/download/1.2.0/rules_pkg-1.2.0.tar.gz
    https://github.com/bazelbuild/rules_shell/releases/download/v0.6.1/rules_shell-v0.6.1.tar.gz
    https://github.com/bazelbuild/rules_swift/releases/download/3.5.0/rules_swift.3.5.0.tar.gz
    https://github.com/hiroyuki-komatsu/japanese-usage-dictionary/archive/refs/tags/2025-01-25.zip
    https://github.com/hiroyuki-komatsu/japanpost_zipcode/raw/621d059fbcbfae17bfca15b439692bae934268c3/jigyosyo.zip
    https://github.com/hiroyuki-komatsu/japanpost_zipcode/raw/621d059fbcbfae17bfca15b439692bae934268c3/ken_all.zip
    https://github.com/madler/zlib/releases/download/v1.3.1/zlib-1.3.1.tar.gz
    https://github.com/protocolbuffers/protobuf/releases/download/v34.1/protobuf-34.1.bazel.tar.gz
    https://github.com/protocolbuffers/protobuf/releases/download/v34.1/protoc-34.1-linux-aarch_64.zip
    https://github.com/protocolbuffers/protobuf/releases/download/v34.1/protoc-34.1-linux-x86_64.zip
)

# mozc-ut (Arch Linux)
ENABLED_DICTIONARIES=(
    'alt-cannadic'
    'edict2'
    'jawiki'
    'neologd'
    'personal-names'
    'place-names'
    'skk-jisyo'
    'sudachidict'
)

declare -A _ut_repos=(
      [merge-ut-dictionaries]="6239884099ddc0c4d5bb1453b20441121d20593e"
      [mozcdic-ut-alt-cannadic]="e7230d7f6d9b72cb656a1eb23d2ccdb7c70d141f"
      [mozcdic-ut-edict2]="8fe8f7918baf513c3d7e243807dfcda2d5c30139"
      [mozcdic-ut-jawiki]="57af6adefedab262c295c4bfff71a89902cbe05c"
      [mozcdic-ut-neologd]="d8307abf02b830b185c9320822cffa0d0787c54e"
      [mozcdic-ut-personal-names]="b557dd4c1548cc7c2164d5f8b14170c40cbb6f81"
      [mozcdic-ut-place-names]="98cf8e9d7731695a52e5bc72ed633933c71d1913"
      [mozcdic-ut-skk-jisyo]="7c02e535bd6d999a715a53b58c3366f2401bfb7f"
      [mozcdic-ut-sudachidict]="c686771bada1d59e9b105c81b29e6ac1a239cb54"
)

declare -A _extra_repos=(
  [breakpad]="https://chromium.googlesource.com/breakpad/breakpad|${_breakpad_commit}"
  [googletest]="https://github.com/google/googletest.git|${_gtest_commit}"
  [japanese-usage-dictionary]="https://github.com/hiroyuki-komatsu/japanese-usage-dictionary.git|${_japanese_usage_dictionary_commit}"
  [jsoncpp]="https://github.com/open-source-parsers/jsoncpp.git|${_jsoncpp_commit}"
  [protobuf]="https://github.com/google/protobuf.git|${_protobuf_commit}"
  [abseil-cpp]="https://github.com/abseil/abseil-cpp.git|${_abseil_cpp_commit}"
  [mozcdict-ext]="https://github.com/reasonset/mozcdict-ext.git|${_dictext_commit}"
  [mecab-ipadic-neologd]="https://github.com/neologd/mecab-ipadic-neologd.git|${_neologd_commit}"
)

jawiki_ver="20261001"
zipcode_commit="621d059fbcbfae17bfca15b439692bae934268c3"

jigyosyo_ver="20260403"
ken_all_ver="20260403"
##############################################################

source /usr/share/plamobuild_functions.sh

B=$W/build

# このスクリプトで使う1文字変数の意味
#
# $W : このスクリプトを動かすカレントディレクトリ
# $S : ソースコードのあるディレクトリ(デフォルト: $W/${src})
# $B : ビルド用ディレクトリ(デフォルト: /tmp/build)
# $P : ビルドしたファイルをインストールするディレクトリ（デフォルト: $W/work)

if [ $# -eq 0 ] ; then
  opt_download=0 ; opt_config=1 ; opt_build=1 ; opt_package=1
else
  opt_download=0 ; opt_config=0 ; opt_build=0 ; opt_package=0
  for i in $@ ; do
    case $i in
    download) opt_download=1 ;;
    config) opt_config=1 ;;
    build) opt_build=1 ;;
    package) opt_package=1 ;;
    esac
  done
fi
if [ $opt_download -eq 1 ] ; then
    download_sources

    set -euo pipefail

    git -C $S fetch --all
    git -C $S submodule update --init --recursive

    echo "==> bazel-central-registry を取得"
    if [[ ! -d bazel-central-registry ]]; then
      git clone https://github.com/bazelbuild/bazel-central-registry bazel-central-registry
    fi
    git -C bazel-central-registry fetch --all
    git -C bazel-central-registry checkout ${_bcr_commit} -B build

    echo "==> UT辞書関連リポジトリを取得"
    for repo in "${!_ut_repos[@]}"; do
      if [[ ! -d "${repo}" ]]; then
        git clone "https://github.com/utuhiro78/${repo}.git" "${repo}"
      fi
      git -C "${repo}" fetch --all
      git -C "${repo}" checkout ${_ut_repos[$repo]} -B build
    done
    
    echo "==> jawikiインデックス、bazel本体、bazel依存ファイルをダウンロード"
    echo "Downloading https://dumps.wikimedia.org/jawiki/${jawiki_ver}/jawiki-${jawiki_ver}-pages-articles-multistream-index.txt.bz2"
    curl -L --fail --retry 5 --retry-delay 10 --retry-all-errors -o jawiki-${jawiki_ver}-pages-articles-multistream-index.txt.bz2 \
      "https://dumps.wikimedia.org/jawiki/${jawiki_ver}/jawiki-${jawiki_ver}-pages-articles-multistream-index.txt.bz2"
    
    echo "Downloading ${_bazel_bin_url}"
    curl -L --fail --retry 5 --retry-delay 10 --retry-all-errors -o "bazel-${_bazel_bin_ver}-linux-x86_64" "${_bazel_bin_url}"
    chmod u+x "bazel-${_bazel_bin_ver}-linux-x86_64"
    
    echo "Downloading https://github.com/hiroyuki-komatsu/japanpost_zipcode/raw/${zipcode_commit}/jigyosyo.zip"
    curl -L --fail --retry 5 --retry-delay 10 --retry-all-errors -o jigyosyo-${jigyosyo_ver}.zip \
      "https://github.com/hiroyuki-komatsu/japanpost_zipcode/raw/${zipcode_commit}/jigyosyo.zip"
    echo "Downloading https://github.com/hiroyuki-komatsu/japanpost_zipcode/raw/${zipcode_commit}/ken_all.zip"
    curl -L --fail --retry 5 --retry-delay 10 --retry-all-errors -o ken_all-${ken_all_ver}.zip \
      "https://github.com/hiroyuki-komatsu/japanpost_zipcode/raw/${zipcode_commit}/ken_all.zip"

    echo "==> bazel 依存ファイルをダウンロード"
    for url in "${_bazel_deps[@]}"; do
      fname="${url##*/}"
      if [[ ! -f "${fname}" ]]; then
        echo "Downloading $url"
        curl -L --fail --retry 5 --retry-delay 10 --retry-all-errors -o "${fname}" "${url}"
      fi
    done

    echo "==> ext neologd 関連を取得"
    for repo in "${!_extra_repos[@]}"; do
      url="${_extra_repos[$repo]%%|*}"
      commit="${_extra_repos[$repo]##*|}"
      if [[ ! -d "${repo}" ]]; then
        git clone "${url}" "${repo}"
      fi
      git -C "${repo}" fetch --all
      git -C "${repo}" checkout ${commit} -B build
    done
    
    echo "==> mozcdict-ext / mecab-ipadic-neologd を取得"
    if [[ ! -d mozcdict-ext ]]; then
      git clone https://github.com/reasonset/mozcdict-ext.git mozcdict-ext
    fi
    git -C mozcdict-ext fetch --all
    git -C mozcdict-ext checkout ${_dictext_commit} -B build
    
    if [[ ! -d mecab-ipadic-neologd ]]; then
      git clone https://github.com/neologd/mecab-ipadic-neologd.git mecab-ipadic-neologd
    fi
    git -C mecab-ipadic-neologd fetch --all
    git -C mecab-ipadic-neologd checkout ${_neologd_commit} -B build

    cd $S
    git config protocol.file.allow always
    git submodule init 2>/dev/null || true
    git config submodule.src/third_party/breakpad.url $W/breakpad 2>/dev/null || true
    git config submodule.src/third_party/gtest.url $W/googletest 2>/dev/null || true
    git config submodule.src/third_party/japanese-usage-dictionary.url $W/japanese-usage-dictionary 2>/dev/null || true
    git config submodule.src/third_party/jsoncpp.url $W/jsoncpp 2>/dev/null || true
    git config submodule.src/third_party/protobuf.url $W/protobuf 2>/dev/null || true
    git config submodule.src/third_party/abseil-cpp.url $W/abseil-cpp 2>/dev/null || true
    git -c protocol.file.allow=always submodule update 2>/dev/null || true

    cd $S/src
    # NEologd/Sudachi/byhand辞書を生成し dictionary09.txt に追記
    echo "==> NEologd/Sudachi/byhand"
    git checkout data/dictionary_oss/dictionary09.txt 2>/dev/null || true

    cd $W/mozcdict-ext
    git submodule init 2>/dev/null || true
    git config submodule.neologd/upstream.url "$W/mecab-ipadic-neologd" 2>/dev/null || true
    git -c protocol.file.allow=always submodule update 2>/dev/null || true

    set +euo pipefail
fi

if [ $opt_config -eq 1 ] ; then
    for f in $addfiles $patchfiles
    do
        if [ ! -f $f ]; then
            echo "Required file ($f) is missing."
            exit 255
        fi
    done

    if [ -d $B ] ; then rm -rf $B ; fi ;  cp -a $S $B  
    cd $B
    for patch in $patchfiles ; do
        if [ ! -f .${patch} ]; then
            patch -p1 < $W/$patch
            touch .${patch}
        fi
    done

    set -euo pipefail

    echo "==> prepare: config.bzl / MODULE.bazel の更新"
    SHA256_ZIP_CODE_KEN_ALL=$(sha256sum $W/ken_all-${ken_all_ver}.zip | cut -d' ' -f1)
    SHA256_ZIP_CODE_JIGYOSYO=$(sha256sum $W/jigyosyo-${jigyosyo_ver}.zip | cut -d' ' -f1)
    
    cd $B
    sed -e "s|SHA256_ZIP_CODE_KEN_ALL = \(.*\)|SHA256_ZIP_CODE_KEN_ALL = \"${SHA256_ZIP_CODE_KEN_ALL}\"|" \
        -e "s|SHA256_ZIP_CODE_JIGYOSYO = \(.*\)|SHA256_ZIP_CODE_JIGYOSYO = \"${SHA256_ZIP_CODE_JIGYOSYO}\"|" \
        -i src/config.bzl src/MODULE.bazel    

    # ファイル名がjigyosyo-${jigyosyo_ver}.zip / ken_all-${ken_all_ver}.zipに変わったことをMODULE.bazelにも反映
    sed -i -e "s|jigyosyo\.zip|jigyosyo-${jigyosyo_ver}.zip|g ; s|ken_all\.zip|ken_all-${ken_all_ver}.zip|g" src/MODULE.bazel

    # ==== UT辞書のマージ処理 ====
    echo "==> UT辞書をマージ"
    cp -a $W/merge-ut-dictionaries $B/
    # $W 以下を汚したくないのでビルドディレクトリにコピー
    cd "$B/merge-ut-dictionaries/src/merge/"
    
    sed -i -e "s|mozc-master/src/data/dictionary_oss|$B/src/data/dictionary_oss|g ; \
               84s|ZipFile(f'mozc-{date_str}\.zip') as zip_ref|open('merge_dictionaries\.py') as dummy_ref| ; \
               86s|zip_ref\.|| ; \
               96s|zip_ref\.namelist()|os\.listdir(path='$B/src/data/dictionary_oss')| ; \
               104s|zip_ref\.|| ; \
               169s|jawiki_index_file = .*|jawiki_index_file = '$W/jawiki-${jawiki_ver}-pages-articles-multistream-index.txt.bz2'| ; \
               152,168d;89,90d;80,83d;67,79d ; \
               7i import os" merge_dictionaries.py

    echo "Compiling the UT dictionary..."
    [[ -e mozcdic-ut.txt ]] && rm mozcdic-ut.txt
    
    for dict in "${ENABLED_DICTIONARIES[@]}"; do
      bzip2 -dfk "$W/mozcdic-ut-${dict}/mozcdic-ut-${dict}.txt.bz2"
      cat "$W/mozcdic-ut-${dict}/mozcdic-ut-${dict}.txt" >> mozcdic-ut.txt
    done
    
    python merge_dictionaries.py mozcdic-ut.txt
    cat mozcdic-ut.txt >> "$B/src/data/dictionary_oss/dictionary00.txt"

    echo "==> NEologd/Sudachi/byhand辞書を生成"
    # $W 以下を汚したくないのでビルドディレクトリにコピー
    cp -a $W/mozcdict-ext $B/
    cd $B/mozcdict-ext
    (
      (cd neologd && MOZC_ID_FILE="$B/src/data/dictionary_oss/id.def" zsh mkdict.zsh)
      (cd sudachi  && MOZC_ID_FILE="$B/src/data/dictionary_oss/id.def" zsh mkdict.zsh)
      (cd byhand   && MOZC_ID_FILE="$B/src/data/dictionary_oss/id.def" zsh mkdict.zsh)
    ) | ruby .dev.utils/uniqword.rb 2>/dev/null >> "$B/src/data/dictionary_oss/dictionary09.txt"

    set +euo pipefail
fi

if [ $opt_build -eq 1 ] ; then
    set -euo pipefail
    echo "==> mozc をビルド(fcitx5モジュール含む、UT辞書統合済み)"
    export JAVA_HOME='/usr/java/jdk-22.0.2'
    export PATH=$JAVA_HOME/bin:$PATH
    cd $B/src 

    bazel_bin=${_bazel_bin_url##*/} 
    
    $W/$bazel_bin build \
        --config oss_linux \
        --config stable_channel \
        --config release_build \
        --config no_sframe \
        --distdir="$W" \
        --registry="file://$W/bazel-central-registry" \
        --copt=-DNDEBUG \
        "${conlyopts[@]}" \
        "${cxxopts[@]}" \
        --nostart_end_lib \
        --features='-supports_start_end_lib' \
        --linkopt=-fuse-ld=bfd \
        "${linkopts[@]}" \
        --copt="-Wno-uninitialized" \
        --host_copt="-Wno-uninitialized" \
        --subcommands \
        --verbose_failures \
        unix/fcitx5:fcitx5-mozc.so \
        server:mozc_server \
        gui/tool:mozc_tool \
	unix/icons \
	unix/emacs:mozc_emacs_helper

    set +euo pipefail
    echo "==> ビルド完了。"
fi

if [ $opt_package -eq 1 ] ; then
  check_root

# mozc
  if [ -d $P ] ; then rm -rf $P ; fi ; mkdir -p $P
  cd $B/src

  # BSD-3-Clause
  sed -n 67,94p data/installer/credits_en.html > Mozc
  install -Dm644 Mozc $docdir/mozc/Mozc
  # BSD-3-Clause
  sed -n 317,344p data/installer/credits_en.html > Breakpad
  install -Dm644 Breakpad $docdir/mozc/Breakpad
  # NAIST-2003
  sed -n 355,424p data/installer/credits_en.html > IPAdic
  install -Dm644 IPAdic $docdir/mozc/IPAdic
  # BSD-2-Clause
  sed -n 435,457p data/installer/credits_en.html > Japanese-Usage-Dictionary
  install -Dm644 Japanese-Usage-Dictionary $docdir/mozc/Japanese-Usage-Dictionary
  # Public Domain Data
  sed -n 468,470p data/installer/credits_en.html > Okinawa-Dictionary
  install -Dm644 Okinawa-Dictionary $docdir/mozc/Okinawa-Dictionary
  # BSD-3-Clause
  sed -n 481,513p data/installer/credits_en.html > Protocol-Buffers
  install -Dm644 Protocol-Buffers $docdir/mozc/Protocol-Buffers
  # MIT
  sed -n 698,704p data/installer/credits_en.html > Tamachi-Phonetic-Kanji-Alphabet
  install -Dm644 Tamachi-Phonetic-Kanji-Alphabet $docdir/mozc/Tamachi-Phonetic-Kanji-Alphabet
  # MIT
  sed -n 762,782p data/installer/credits_en.html > Windows-Implementation-Library
  sed -i -e 's|^[ \t]*||g' Windows-Implementation-Library
  install -Dm644 Windows-Implementation-Library $docdir/mozc/Windows-Implementation-Library

  cd $B/src
  export PREFIX="$P/usr"
  ../scripts/install_server_bazel

  # gen_zipcode-dic_
  install -Dm755 $W/generate-zipcode-dic.sh $P/usr/lib/mozc/tools/generate-zipcode-dic.sh
  install -Dm644 $W/jigyosyo-convert-mozc-dictionary.awk $P/usr/lib/mozc/tools/jigyosyo-convert-mozc-dictionary.awk
  install -Dm644 $W/ken_all-convert-mozc-dictionary.awk $P/usr/lib/mozc/tools/ken_all-convert-mozc-dictionary.awk

  if [ ! -d $P/usr/bin ];then
	mkdir $P/usr/bin
  fi
  cd $P/usr/bin
  ln -s ../lib/mozc/tools/generate-zipcode-dic.sh generate-zipcode-dic
  cd $B/src

  install -Dm644 $W/LICENSE.japanese-zip-code-dictionary $docdir/mozc/japanese-zip-code-dictionary
  install -Dm644 $W/LICENSE.japanese-zip-code-dictionary $P/usr/lib/mozc/LICENSE

  install -Dm644 $W/README.v2.0.generate-zipcode-dic $docdir/mozc/README.v2.0.generate-zipcode-dic

  # install addfiles
  for add in $addfiles ; do
    cp $W/$add $docdir/mozc/$add
    gzip $docdir/mozc/$add
  done

################################
#      install tweaks
#  strip binaries, delete locale except ja, compress man,
#  install docs and patches, compress them and  chown root.root
################################
  install_tweak

#############################
#   convert symlink to null file and
#   add "ln -sf" command into install/doinst.sh
################################
  convert_links

  cd $P
  /sbin/makepkg ../$pkg.$compress <<EOF
y
1
EOF

# fcitx5_mozc
  cd $B/src
  if [ -d $P ] ; then rm -rf $P ; fi ; mkdir -p $P

  export PREFIX="$P/usr"
  ../scripts/install_fcitx5_bazel

  install_tweak
  convert_links

  cd $P
  /sbin/makepkg ../fcitx5_mozc-$vers-$arch-$build.$compress <<EOF
y
1
EOF
 
# emacs_mozc
  cd $B/src
  if [ -d $P ] ; then rm -rf $P ; fi ; mkdir -p $P

  install -Dm755 bazel-bin/unix/emacs/mozc_emacs_helper "$P"/usr/bin/mozc_emacs_helper
  install -Dm644 unix/emacs/mozc.el "$P"/usr/share/emacs/site-lisp/mozc.el

  install_tweak
  convert_links

  cd $P
  /sbin/makepkg ../emacs_mozc-$vers-$arch-$build.$compress <<EOF
y
1
EOF
 
fi
