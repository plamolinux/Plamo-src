#!/bin/sh
##############################################################
pkgbase="dbus"
vers="1.16.2"
url="https://dbus.freedesktop.org/releases/dbus/dbus-${vers}.tar.xz"
verify=""
digest=""
arch=`uname -m`
build=B1
src="dbus-${vers}"
OPT_CONFIG="--buildtype=release -Druntime_dir=/run -Duser_session=true -Dsystemd=disabled -Dselinux=disabled -Ddoxygen_docs=disabled -Dxml_docs=disabled -Dsystem_pid_file=/run/dbus/pid -Dsystem_socket=/run/dbus/system_bus_socket"
DOCS="AUTHORS COPYING INSTALL LICENSES NEWS NEWS.pre-1-0 NEWS.pre-1-10 NEWS.pre-1-12 NEWS.pre-1-2 NEWS.pre-1-4 NEWS.pre-1-6 NEWS.pre-1-8 README README.cmake README.cygwin README.launchd README.valgrind README.win README.wince doc meson_post_install.py"
patchfiles=""
# specifies files that are not in source archive and patchfiles
addfiles=""
compress=tzst
##############################################################

source /usr/share/plamobuild_functions.sh

# このスクリプトで使う1文字変数の意味
#
# $W : このスクリプトを動かすカレントディレクトリ
# $S : ソースコードのあるディレクトリ(デフォルト: $W/${src})
# $B : ビルド用ディレクトリ(デフォルト: /tmp/build)
# $P : ビルドしたファイルをインストールするディレクトリ（デフォルト: $W/work)

if [ $# -eq 0 ] ; then
  opt_download=0 ; opt_config=1 ; opt_build=1 ; opt_package=1
else
  opt_download=0 ; opt_config=0 ; opt_build=0 ; opt_package=0
  for i in $@ ; do
    case $i in
    download) opt_download=1 ;;
    config) opt_config=1 ;;
    build) opt_build=1 ;;
    package) opt_package=1 ;;
    esac
  done
fi
if [ $opt_download -eq 1 ] ; then
    download_sources
fi


if [ $opt_config -eq 1 ] ; then

    for f in $addfiles $patchfiles
    do
        if [ ! -f $f ]; then
            echo "Required file ($f) is missing."
            exit 255
        fi
    done

######################################################################
#  out of tree build. patch apply in src dir
######################################################################
    if [ -d $B ] ; then rm -rf $B ; fi ; mkdir -p $B 
    cd $S
    for patch in $patchfiles ; do
        if [ ! -f .${patch} ]; then
            patch -p1 < $W/$patch
            touch .${patch}
        fi
    done
    # if [ -f autogen.sh ] ; then
    #   sh ./autogen.sh
    # fi
    cd $B
    export PKG_CONFIG_PATH=/usr/${libdir}/pkgconfig:/usr/share/pkgconfig
    export LDFLAGS='-Wl,--as-needed' 
    meson --prefix=/usr --libdir=/usr/${libdir} ${OPT_CONFIG} $S  
    if [ $? != 0 ]; then
        echo "configure error. $0 script stop"
        exit 255
    fi
fi

if [ $opt_build -eq 1 ] ; then
    cd $B 
    ninja
    if [ $? != 0 ]; then
        echo "build error. $0 script stop"
        exit 255
    fi
fi

if [ $opt_package -eq 1 ] ; then
  check_root
  if [ -d $P ] ; then rm -rf $P ; fi ; mkdir -p $P
  cd $B

  DESTDIR=$P ninja install

  mkdir -p $P/${libdir}
  mv -v $P/usr/${libdir}/libdbus-1.so.* $P/${libdir}
  ln -sfv ../../${libdir}/$(readlink $P/usr/${libdir}/libdbus-1.so) $P/usr/lib/libdbus-1.so

  chown -v root:messagebus $P/usr/libexec/dbus-daemon-launch-helper
  chmod -v      4750       $P/usr/libexec/dbus-daemon-launch-helper

  install -v -m 0755 -D $W/dbus.init $P/etc/rc.d/init.d/dbus
  install -v -m 0644 -D $W/dbus.init $docdir/$src/dbus.init

  mkdir -p $P/etc/rc.d/rc{0,1,2,3,4,5,6}.d
  ( cd $P/etc/rc.d/rc0.d ; ln -sf ../init.d/dbus K82dbus )
  ( cd $P/etc/rc.d/rc1.d ; ln -sf ../init.d/dbus K82dbus )
  ( cd $P/etc/rc.d/rc2.d ; ln -sf ../init.d/dbus S29dbus )
  ( cd $P/etc/rc.d/rc3.d ; ln -sf ../init.d/dbus S29dbus )
  ( cd $P/etc/rc.d/rc4.d ; ln -sf ../init.d/dbus S29dbus )
  ( cd $P/etc/rc.d/rc5.d ; ln -sf ../init.d/dbus S29dbus )
  ( cd $P/etc/rc.d/rc6.d ; ln -sf ../init.d/dbus K82dbus )

  ln -sv /var/lib/dbus/machine-id $P/etc

################################
#      install tweaks
#  strip binaries, delete locale except ja, compress man,
#  install docs and patches, compress them and  chown root.root
################################
  install_tweak

#############################
#   convert symlink to null file and
#   add "ln -sf" command into install/doinst.sh
################################
  convert_links

  cd $P
  /sbin/makepkg ../$pkg.$compress <<EOF
y
1
EOF

fi
