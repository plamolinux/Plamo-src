#!/bin/sh
##############################################################
pkgbase='go'
vers="1.26.6"
url="https://go.dev/dl/go${vers}.src.tar.gz"
url2="https://go.dev/dl/go${vers}.linux-amd64.tar.gz"
digest=""
verify=""
arch=`uname -m`
build=B1
src="go"
OPT_CONFIG=""
DOCS=""
patchfiles=''
compress=tzst
##############################################################

export NO_STRIP=1

source /usr/share/plamobuild_functions.sh

# このスクリプトで使う1文字変数の意味
#
# $W : このスクリプトを動かすカレントディレクトリ
# $S : ソースコードのあるディレクトリ(デフォルト: $W/${src})
# $B : ビルド用ディレクトリ(デフォルト: /tmp/build{,32})
# $P : ビルドしたファイルをインストールするディレクトリ（デフォルト: $W/work)

export GOOS=linux
case "$arch" in
    x86_64)
	export GOARCH=amd64
	export GOAMD64=v1
	;;
esac
export GOROOT_FINAL=/usr/${libdir}/go
export GOROOT_BOOTSTRAP=$W/root/go

if [ $# -eq 0 ] ; then
  opt_download=0 ; opt_config=1 ; opt_build=1 ; opt_package=1
else
  opt_download=0 ; opt_config=0 ; opt_build=0 ; opt_package=0
  for i in $@ ; do
    case $i in
    download) opt_download=1 ;;
    config) opt_config=1 ;;
    build) opt_build=1 ;;
    package) opt_package=1 ;;
    esac
  done
fi
if [ $opt_download -eq 1 ] ; then
  download_sources
  wget -N $url2
  mkdir -p $W/root
  tar xvf $(basename $url2) -C $W/root
fi

if [ $opt_config -eq 1 ] ; then
  if [ -d $B ] ; then rm -rf $B ; fi ; cp -a $S $B
######################################################################
#  don't copy sources, so need patch in the src dir
######################################################################
  cd $B
  for patch in $patchfiles ; do
    patch -p1 < $W/$patch
  done
fi
    
if [ $opt_build -eq 1 ] ; then
    cd $B/src
    ./make.bash -v
fi

if [ $opt_package -eq 1 ] ; then
  check_root
  if [ -d $P ] ; then rm -rf $P ; fi ; mkdir -p $P
  cd $B
  install -dm755 -v $P/usr/bin \
	  $P/usr/${libdir}/go \
	  $docdir/go-${vers} \
	  $P/usr/${libdir}/go/pkg/linux_amd64_{dynlink,race}

  cp -av bin pkg src lib misc api test $P/usr/${libdir}/go/
  cp -r doc/* $docdir/go-${vers}

  ln -sfv /usr/${libdir}/go/bin/go $P/usr/bin/go
  ln -sfv /usr/${libdir}/go/bin/gofmt $P/usr/bin/gofmt
  ln -sfv /usr/share/doc/go-${vers} $P/usr/${libdir}/go/doc

  install -Dm644 VERSION $P/usr/${libdir}/go/VERSION

  rm -rfv "$P"/usr/${libdir}/go/pkg/obj/go-build
  rm -rfv $P/usr/${libdir}/go/pkg/bootstrap
  rm -rfv $P/usr/${libdir}/go/pkg/tool/*/api

  install -Dm644 go.env $P/usr/${libdir}/go/go.env

  docs="CONTRIBUTING.md  LICENSE  PATENTS  README.md  SECURITY.md  VERSION"
  for f in $docs
  do
      install -Dm644 $f $docdir/go-${vers}/$f
  done

  if [ "$EUID" -eq 0 ]; then
      chown -R root:root $P
  fi

################################
#      install tweaks
#  strip binaries, delete locale except ja, compress man, 
#  install docs and patches, compress them and  chown root.root
################################
  install_tweak

#############################
#   convert symlink to null file and 
#   add "ln -sf" command into install/doinst.sh
################################
  convert_links

  cd $P
  /sbin/makepkg ../$pkg.$compress <<EOF
y
1
EOF

fi
